# 复制为 .env 并填入真实值。真实密钥绝不入库（仓库硬性纪律）。
DATABASE_URL=postgres://scholar:scholar@localhost:5432/scholar?sslmode=disable
ANTHROPIC_API_KEY=sk-ant-xxx
DEEPSEEK_API_KEY=sk-xxx

# Embedding（默认 siliconflow，BAAI/bge-m3，1024 维）
# 在 https://cloud.siliconflow.cn/account/ak 创建 API key
SF_API_KEY=sk-xxx
# 可选：切换后端 / 模型
# EMBED_BACKEND=ollama          # 改回本机 Ollama（调试用）
# SF_EMBED_MODEL=BAAI/bge-m3    # 默认值，无需修改

# RSSHub（采集用，默认本机）
RSSHUB_BASE=http://127.0.0.1:1200

# Langfuse（M1 接入）
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 单次 LLM 请求超时（秒）；必须明显短于 pgmq visibility timeout，避免任务重复领取。
LLM_REQUEST_TIMEOUT_SECONDS=120
